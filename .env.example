# Edram — Intelligence Concurrentielle 2026
# Copiez ce fichier en .env et renseignez vos clés.

# Clé Groq — GRATUITE sur console.groq.com (analyse IA narrative)
# Modèle : llama-3.3-70b-versatile — inscription sans carte bancaire
GROQ_API_KEY=gsk_...

# Clé Anthropic — OPTIONNELLE (uniquement pour collecte automatique PDF)
# Obtenez votre clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Clé API FRED (Federal Reserve Economic Data) — optionnelle
# Améliore la qualité des données macro (F2) et des spreads souverains (F3)
# Obtenez une clé gratuite sur https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Clé API SerpAPI — optionnelle, utilisée par le collecteur automatique
# Permet la recherche Google des rapports de fonds pour l'extraction des positions
# Obtenez une clé sur https://serpapi.com/
SERP_API_KEY=
